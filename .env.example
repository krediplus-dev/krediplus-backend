# Kredi+ Backend 1.3.9 - ejemplo local. NO guardar secretos reales.
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/krediplus
DB_USER=krediplus_app
DB_PASSWORD=change-me
PUBLIC_BASE_URL=http://localhost:8080
# Producción: PUBLIC_BASE_URL=https://api.krediplus.org  (SIN /api/v1)
UPLOAD_DIR=./data/uploads
JWT_SECRET=replace-with-at-least-32-random-bytes
EMAIL_RECOVERY_ENABLED=false
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
SMTP_HOST=mail.krediplus.org
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@krediplus.org
SMTP_PASS=change-me
MAIL_FROM_NAME=Kredi+
MAIL_FROM_ADDRESS=no-reply@krediplus.org
PASSWORD_RESET_CODE_TTL_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_CODE_LENGTH=6
RECAPTCHA_REQUIRED=false
